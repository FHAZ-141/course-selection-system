# ============================================================
#  本地环境变量示例（复制为 .env 后填写）
#
#  规则：
#    · .env 已被 .gitignore 排除，**不要提交**
#    · 进程里显式设置的环境变量优先于本文件
#    · 没有 .env 时自动使用离线 SQLite
# ============================================================

# Neon PostgreSQL 连接串（Render 线上用的是同一个库）
# 把 <user> / <password> / <host> / <db> 换成 Neon 控制台里的实际值
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# 可选：强制离线 SQLite（覆盖上面的 DATABASE_URL）
# DB_DRIVER=sqlite
