{
  "name": "course-selection-system",
  "version": "0.1.0",
  "private": true,
  "description": "软件工程课程作业：选课系统（课程查询、选课、退课、人数限制、时间冲突检查、选课结果查询）",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "init-db": "node src/db/seed.js",
    "reset-db": "node src/db/seed.js --reset",
    "smoke": "bash test/smoke.sh",
    "stress": "node test/stress-test.js",
    "test:conflict": "node test/conflict-test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "node-sqlite3-wasm": "^0.8.60"
  }
}
