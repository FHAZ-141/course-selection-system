%% ============================================================
%%  选课系统 · 用例图（U1）
%%
%%  说明：
%%    · 圆形节点 = 参与者（Actor）
%%    · 胶囊形节点 = 用例（Use Case）
%%    · 实线 = 参与者与用例的关联
%%    · 虚线 = 用例之间的关系（include 包含 / extend 扩展）
%%  注意：Mermaid 无原生 UML 用例图语法，此处用 flowchart 近似表达，
%%        图形语义与 UML 用例图一致（详见 docs/01-需求规格说明书.md 第 4 节）
%% ============================================================

flowchart LR
    STU((学生))
    TEA((教师))
    ADM((管理员))

    subgraph SYS["高校选课系统"]
        direction TB
        UC01(["登录 / 退出"])
        UC02(["课程查询"])
        UC03(["查看课程详情"])
        UC04(["选课"])
        UC05(["退课"])
        UC06(["加入候补队列"])
        UC07(["退出候补队列"])
        UC08(["查看选课结果"])
        UC09(["查看公告"])
        UC10(["查看所授课程"])
        UC11(["查看选课名单"])
        UC12(["查看授课时间冲突"])
        UC13(["管理课程"])
        UC14(["配置选课窗口"])
        UC15(["管理公告"])
        UC16(["查看选课统计"])
    end

    STU --- UC01
    STU --- UC02
    STU --- UC04
    STU --- UC05
    STU --- UC07
    STU --- UC08
    STU --- UC09

    TEA --- UC01
    TEA --- UC02
    TEA --- UC09
    TEA --- UC10
    TEA --- UC12

    ADM --- UC01
    ADM --- UC02
    ADM --- UC09
    ADM --- UC13
    ADM --- UC14
    ADM --- UC15
    ADM --- UC16

    UC02 -.->|include| UC03
    UC04 -.->|extend：名额已满时| UC06
    UC10 -.->|include| UC11
