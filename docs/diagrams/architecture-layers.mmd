%% ============================================================
%%  选课系统 · 分层架构图（D2 正文用图）
%%
%%  说明：本图不是 UML 标准图，用于说明请求在分层间的流向与依赖方向。
%% ============================================================

flowchart TB
    B["浏览器<br/>（表单提交 / 页面跳转）"]

    subgraph APP["Node.js 单进程（Express）"]
        direction TB
        R["路由层 src/routes/*.js<br/>取参数 · 鉴权 · 调服务 · 选模板"]
        S["服务层 src/services/*.js<br/>业务规则：冲突判定 · 容量校验 · 候补补位"]
        D["数据访问层 src/db/index.js<br/>连接管理 · 参数规整 · 事务封装"]
        V["视图层 views/*.ejs<br/>服务端渲染，不含业务判断"]
    end

    DB[("SQLite 单文件<br/>data/course-selection.sqlite")]

    B -- "HTTP 请求" --> R
    R -- "调用" --> S
    S -- "SQL" --> D
    D -- "读写" --> DB
    R -- "传入数据" --> V
    V -- "HTML" --> B

    classDef layer fill:#eef3fb,stroke:#4a6fa5,stroke-width:1px,color:#1f2937
    class R,S,D,V layer
