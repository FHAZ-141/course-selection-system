<%- include('partials/header') %>

<div class="login-wrap">
  <div class="login-card">
    <h1 class="login-title">登录<%= appName %></h1>
    <p class="login-sub">请使用学号 / 工号登录</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="post" action="/login" class="form">
      <input type="hidden" name="next" value="<%= next %>">

      <label class="field">
        <span class="field-label">学号 / 工号</span>
        <input type="text" name="username" value="<%= username %>" autocomplete="username" autofocus required>
      </label>

      <label class="field">
        <span class="field-label">密码</span>
        <input type="password" name="password" autocomplete="current-password" required>
      </label>

      <button type="submit" class="btn btn-primary btn-block">登录</button>
    </form>

    <div class="demo-accounts">
      <div class="demo-title">演示账号（密码均为 123456）</div>
      <table class="table table-compact">
        <thead>
          <tr><th>角色</th><th>账号</th><th>姓名</th></tr>
        </thead>
        <tbody>
          <tr><td>管理员</td><td><code>admin</code></td><td>系统管理员</td></tr>
          <tr><td>教师</td><td><code>T1001</code></td><td>张伟</td></tr>
          <tr><td>教师</td><td><code>T1002</code></td><td>李娜</td></tr>
          <tr><td>教师</td><td><code>T1010</code></td><td>郑海</td></tr>
          <tr><td>学生</td><td><code>2024010101</code></td><td>陈思远</td></tr>
          <tr><td>学生</td><td><code>2024010102</code></td><td>林悦</td></tr>
          <tr><td>学生</td><td><code>2024010104</code></td><td>周雨桐</td></tr>
          <tr><td>学生</td><td><code>2024010113</code></td><td>沈亦凡</td></tr>
          <tr><td>学生</td><td><code>2024010114</code></td><td>韩雨琪</td></tr>
          <tr><td>学生</td><td><code>2024010115</code></td><td>曹子航</td></tr>
        </tbody>
      </table>

      <div class="demo-hint">
        <p>共 <strong>40</strong> 名学生（<code>2024010101</code>~<code>2024010140</code>）、
          <strong>12</strong> 名教师（<code>T1001</code>~<code>T1012</code>），密码同上。</p>
        <p><strong>看数据联动</strong>：用一个学生选课 → 换该课教师看「选课名单」→
          再用管理员看「选课统计」，三处人数会同步变化。</p>
        <p><strong>看满员与补位</strong>：《前沿技术研讨》（CS111，容量 2）已满，
          <code>2024010104</code>、<code>2024010105</code> 在候补队列中。</p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
