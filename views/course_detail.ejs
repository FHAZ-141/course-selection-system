<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1 class="page-title">
      <%= course.name %>
      <code class="title-code"><%= course.code %></code>
    </h1>
    <p class="page-sub">
      <span class="muted"><%= course.teacher_name %></span>
      <% if (course.department) { %>
        <span class="dot">·</span><span class="muted"><%= course.department %></span>
      <% } %>
      <span class="dot">·</span><span class="muted"><%= fmt.credits(course.credits) %> 学分</span>
    </p>
  </div>
  <div class="head-actions">
    <% if (course.status === 'closed') { %>
      <span class="badge badge-warn badge-lg">停开</span>
    <% } else if (course.isFull) { %>
      <span class="badge badge-warn badge-lg">名额已满</span>
    <% } else { %>
      <span class="badge badge-ok badge-lg">可报名</span>
    <% } %>
    <% if (course.my_status) { %>
      <span class="badge badge-student badge-lg"><%= fmt.enrollmentStatusLabel(course.my_status) %></span>
    <% } %>
  </div>
</div>

<div class="columns">
  <section class="panel">
    <h2 class="panel-title">上课时间</h2>
    <% if (course.class_times.length === 0) { %>
      <p class="empty">该课程尚未排课</p>
    <% } else { %>
      <ul class="plain-list">
        <% course.class_times.forEach(function (ct) { %>
          <li><%= fmt.describeClassTime(ct) %></li>
        <% }); %>
      </ul>
    <% } %>

    <h2 class="panel-title panel-title-gap">上课地点</h2>
    <p><%= course.location || '未指定' %></p>

    <% if (course.description) { %>
      <h2 class="panel-title panel-title-gap">课程简介</h2>
      <p class="muted"><%= course.description %></p>
    <% } %>
  </section>

  <section class="panel">
    <h2 class="panel-title">选课情况</h2>

    <div class="capacity-block">
      <div class="capacity-head">
        <span>已选 <strong><%= course.enrolled_count %></strong> / <%= course.capacity %> 人</span>
        <span class="<%= course.isFull ? 'text-danger' : 'text-ok' %>">
          <%= course.isFull ? '已满' : '剩余 ' + course.remaining + ' 个名额' %>
        </span>
      </div>
      <div class="capacity-bar">
        <div class="capacity-fill <%= course.isFull ? 'is-full' : '' %>"
             style="width: <%= course.capacity > 0 ? Math.min(course.enrolled_count / course.capacity * 100, 100) : 100 %>%"></div>
      </div>
    </div>

    <dl class="kv">
      <dt>容量上限</dt><dd><%= course.capacity %> 人</dd>
      <dt>已选人数</dt><dd><%= course.enrolled_count %> 人</dd>
      <dt>剩余名额</dt><dd><%= course.remaining %> 个</dd>
      <dt>候补人数</dt><dd><%= course.waitlist_count %> 人</dd>
    </dl>

    <% if (course.status === 'closed') { %>
      <div class="alert alert-error">该课程已停开，不可选课。</div>
    <% } else if (course.my_status === 'enrolled') { %>
      <div class="note note-ok">你已选中该课程。</div>
    <% } else if (course.my_status === 'waiting') { %>
      <div class="note note-warn">你正在候补队列中，有同学退课时将按顺序自动补位。</div>
    <% } else if (course.isFull) { %>
      <div class="note note-warn">名额已满，选课时将进入候补队列。</div>
    <% } %>

    <p class="placeholder-note">
      选课与退课操作将在下一模块开放 —— 见 <code>docs/dev/modules/选课与退课.md</code>。
    </p>
  </section>
</div>

<p class="back-link"><a href="/courses">← 返回课程列表</a></p>

<%- include('partials/footer') %>
