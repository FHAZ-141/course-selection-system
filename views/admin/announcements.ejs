<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <h1 class="page-title">公告管理</h1>
    <p class="page-sub"><span class="muted">共 <%= announcements.length %> 条</span></p>
  </div>
  <div class="head-actions">
    <a class="btn btn-sm" href="/announcements">查看公告页</a>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<section class="panel">
  <h2 class="panel-title">发布新公告</h2>

  <form method="post" action="/admin/announcements" class="form">
    <label class="field">
      <span class="field-label">标题 *<span class="field-hint-inline">（最多 <%= limits.title %> 字）</span></span>
      <input type="text" name="title" value="<%= form.title %>" maxlength="<%= limits.title %>" required>
    </label>

    <label class="field">
      <span class="field-label">内容 *<span class="field-hint-inline">（最多 <%= limits.content %> 字，支持换行）</span></span>
      <textarea name="content" rows="5" maxlength="<%= limits.content %>" required><%= form.content %></textarea>
    </label>

    <label class="checkbox-field">
      <input type="checkbox" name="pinned" <%= form.pinned ? 'checked' : '' %>>
      <span>置顶显示</span>
    </label>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">发布</button>
    </div>
  </form>
</section>

<section class="panel panel-gap">
  <h2 class="panel-title">已有公告</h2>

  <% if (announcements.length === 0) { %>
    <p class="empty">暂无公告。</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>标题</th>
          <th class="col-num">发布人</th>
          <th class="col-num">发布时间</th>
          <th class="col-actions">操作</th>
        </tr>
      </thead>
      <tbody>
        <% announcements.forEach(function (a) { %>
          <tr>
            <td>
              <% if (a.pinned) { %><span class="tag tag-pin">置顶</span><% } %>
              <a class="strong-link" href="/announcements/<%= a.id %>"><%= a.title %></a>
            </td>
            <td class="col-num muted"><%= a.author_name %></td>
            <td class="col-num muted"><%= fmt.dateTime(a.created_at) %></td>
            <td class="col-actions">
              <form method="post" action="/admin/announcements/<%= a.id %>/pin" class="inline-form">
                <button type="submit" class="btn btn-sm"><%= a.pinned ? '取消置顶' : '置顶' %></button>
              </form>
              <form method="post" action="/admin/announcements/<%= a.id %>/delete" class="inline-form"
                    onsubmit="return confirm('确定删除公告「<%= a.title %>」吗？');">
                <button type="submit" class="btn btn-sm btn-danger">删除</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('../partials/footer') %>
